<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign Up — POS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      width: 100%;
      font-family: 'Inter', sans-serif;
    }

    .page {
      width: 100vw;
      height: 100vh;
      background-color: #712f79;
      display: flex;
    }

    /* Form side — 60% of full viewport */
    .form-side {
      flex: 0 0 60%;
      width: 60%;
      background: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(40px, 6vw, 100px);
      overflow-y: auto;
    }

    /* Purple side — 40% of full viewport */
    .purple-side {
      flex: 0 0 40%;
      width: 40%;
      background-color: #712f79;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 48px;
    }

    .pos-input {
      width: 100%;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px 14px 12px 44px;
      font-size: clamp(13px, 1.1vw, 15px);
      font-family: 'Inter', sans-serif;
      color: #111827;
      background: #f9fafb;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .pos-input:focus {
      border-color: #712f79;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(113,47,121,0.08);
    }
    .pos-input::placeholder { color: #9ca3af; }

    .input-wrap { position: relative; }
    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 17px;
      height: 17px;
      color: #9ca3af;
      pointer-events: none;
    }
    .toggle-pw {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 12px;
      color: #9ca3af;
      cursor: pointer;
      user-select: none;
      transition: color 0.15s;
    }
    .toggle-pw:hover { color: #712f79; }

    .btn-submit {
      width: 100%;
      padding: 14px;
      border-radius: 10px;
      background-color: #712f79;
      color: #fff;
      font-size: clamp(13px, 1.1vw, 15px);
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      letter-spacing: 0.3px;
      border: none;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
    }
    .btn-submit:hover { opacity: 0.9; }
    .btn-submit:active { transform: scale(0.98); }

    .deco-circle {
      position: absolute;
      border-radius: 50%;
      background: rgba(255,255,255,0.07);
    }

    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    /* Mobile: stack vertically */
    @media (max-width: 640px) {
      .page { flex-direction: column; height: auto; min-height: 100vh; }
      .form-side { flex: none; width: 100%; padding: 48px 28px; }
      .purple-side { flex: none; width: 100%; min-height: 280px; padding: 40px 28px; }
      .input-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<div class="page">

  <!-- LEFT: Form (60% of screen) -->
  <div class="form-side">

    <!-- Brand -->
    <div style="margin-bottom: clamp(20px, 3vh, 36px);">
      <h1 style="font-size: clamp(22px, 2.5vw, 32px); font-weight: 700; color: #111827; letter-spacing: -0.5px;">FluxRetail</h1>
      <p style="font-size: clamp(12px, 1vw, 14px); color: #9ca3af; margin-top: 5px;">Point of Sale Management System</p>
    </div>

    <h2 style="font-size: clamp(16px, 2vw, 22px); font-weight: 600; color: #1f2937; margin-bottom: clamp(16px, 2.5vh, 28px);">Create Account</h2>

    <%= form_with url: registration_path, method: :post do |f| %>

      <!-- First name & Last name -->
      <div class="input-row" style="margin-bottom: clamp(12px, 2vh, 18px);">

        <div class="input-wrap">
          <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <%= f.text_field :first_name,
                placeholder: "First Name",
                autocomplete: "given-name",
                class: "pos-input" %>
        </div>

        <div class="input-wrap">
          <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <%= f.text_field :last_name,
                placeholder: "Last Name",
                autocomplete: "family-name",
                class: "pos-input" %>
        </div>

      </div>

      <!-- Email -->
      <div class="input-wrap" style="margin-bottom: clamp(12px, 2vh, 18px);">
        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <%= f.text_field :email_address,
              placeholder: "Email Address",
              autocomplete: "email",
              class: "pos-input" %>
      </div>

      <!-- Password -->
      <div class="input-wrap" style="margin-bottom: clamp(12px, 2vh, 18px);">
        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <%= f.password_field :password,
              placeholder: "Password",
              autocomplete: "new-password",
              id: "password",
              class: "pos-input" %>
        <span class="toggle-pw" onclick="togglePassword('password', 'toggleBtn1')" id="toggleBtn1">Show</span>
      </div>

      <!-- Confirm Password -->
      <div class="input-wrap" style="margin-bottom: clamp(16px, 2.5vh, 28px);">
        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <%= f.password_field :password_confirmation,
              placeholder: "Confirm Password",
              autocomplete: "new-password",
              id: "password_confirmation",
              class: "pos-input" %>
        <span class="toggle-pw" onclick="togglePassword('password_confirmation', 'toggleBtn2')" id="toggleBtn2">Show</span>
      </div>

      <!-- Submit -->
      <%= f.submit "Create Account", class: "btn-submit" %>

      <!-- Link to login -->
      <div style="text-align:center; margin-top: 16px;">
        <span style="font-size: 13px; color: #6b7280;">Already have an account? </span>
        <%= link_to "Sign in", new_session_path, style: "font-size: 13px; color: #712f79; font-weight: 600; text-decoration: none;" %>
      </div>

    <% end %>

  </div>

  <!-- RIGHT: Purple panel (40% of screen) -->
  <div class="purple-side">

    <!-- Decorative circles -->
    <div class="deco-circle" style="width:35vw; height:35vw; max-width:400px; max-height:400px; top:-10%; right:-10%;"></div>
    <div class="deco-circle" style="width:25vw; height:25vw; max-width:300px; max-height:300px; bottom:-8%; left:-8%;"></div>
    <div class="deco-circle" style="width:12vw; height:12vw; max-width:140px; max-height:140px; bottom:20%; right:-4%; opacity:0.5;"></div>

    <!-- Logo + text -->
    <div style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap: clamp(16px, 3vh, 28px);">

      <%= image_tag "logo.png",
            style: "width: clamp(120px, 18vw, 180px); height: auto; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.15));",
            alt: "Logo" %>

      <div style="text-align:center;">
        <p style="color:#fff; font-weight:700; font-size:clamp(15px, 1.6vw, 20px); letter-spacing:0.2px;">Get started</p>
        <p style="color:rgba(255,255,255,0.65); font-size:clamp(12px, 1vw, 14px); margin-top:8px; line-height:1.7;">Create your account<br/>to access the system.</p>
      </div>

    </div>
  </div>

</div>

<script>
  function togglePassword(fieldId, btnId) {
    const input = document.getElementById(fieldId);
    const btn = document.getElementById(btnId);
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = 'Hide';
    } else {
      input.type = 'password';
      btn.textContent = 'Show';
    }
  }
</script>

</body>
</html>
