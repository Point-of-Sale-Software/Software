<!DOCTYPE html>
<html lang="en-gb">
  <head>
    <title><%= content_for(:title) || "FluxRetail - Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <div class="flux-layout">
      <!-- Sidebar -->
      <div class="flux-sidebar flex flex-col">
        <h2>FluxRetail</h2>
        <p class="text-purple-200 text-sm -mt-5 mb-6">Admin</p>

        <nav class="flux-sidebar-nav">
          <%= link_to "Dashboard", admin_root_path, class: "#{controller_name == 'home' ? 'active' : ''}" %>
          <%= link_to "Items", admin_items_path, class: "#{controller_name == 'items' ? 'active' : ''}" %>
          <%= link_to "Tills", admin_tills_path, class: "#{controller_name == 'tills' || controller_name == 'till_sessions' ? 'active' : ''}" %>
          <%= link_to "Sales", admin_sales_path, class: "#{controller_name == 'sales' ? 'active' : ''}" %>
          <%= link_to "Users", admin_users_path, class: "#{controller_name == 'users' ? 'active' : ''}" %>
        </nav>

        <div class="flux-sidebar-footer">
          <div class="text-sm text-purple-200 mb-2"><%= Current.user&.name || Current.user&.email_address %></div>
          <%= link_to "Back to Home", root_path, class: "block text-purple-200 hover:text-white text-sm mb-2" %>
          <%= button_to "Sign Out", sessions_path, method: :delete, class: "flux-btn flux-btn-secondary w-full text-sm" %>
        </div>
      </div>

      <!-- Main Content -->
      <div class="flux-main">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
