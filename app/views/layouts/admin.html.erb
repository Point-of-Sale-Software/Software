<% content_for :header do %>
  <nav class="w-full bg-blue-200 p-2 flex flex-inline-col gap-4">
    <div class="flex items-center">
      <h2 class="text-2xl font-bold">Point of Sale - Admin</h2>
    </div>

    <div>
      <%= link_to "Items", [:admin, :items], class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      <%= link_to "Tills", [:admin, :tills], class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>

      <%= button_to "Sign Out", sessions_path, method: :delete, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    </div>
  </nav>
<% end %>

<%= render template: "layouts/application" %>
