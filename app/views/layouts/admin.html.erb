<% content_for :header do %>
  <nav class="w-full bg-blue-200 p-2 flex items-center gap-4">
    <h2 class="text-2xl font-bold">Point of Sale - Admin</h2>

    <div class="flex items-center gap-2">
      <%= link_to "Home", admin_root_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      <%= link_to "Items", [:admin, :items], class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      <%= link_to "Tills", [:admin, :tills], class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
      <%= link_to "Sales", [:admin, :sales], class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    </div>

    <div class="ml-auto">
      <%= button_to "Sign Out", sessions_path, method: :delete, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    </div>
  </nav>
<% end %>

<%= render template: "layouts/application" %>
