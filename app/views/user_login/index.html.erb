<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign In — POS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      width: 100%;
      font-family: 'Inter', sans-serif;
    }

    /* Full screen wrapper — purple background fills entire viewport */
    .page {
      width: 100vw;
      height: 100vh;
      background-color: #712f79;
      display: flex;
    }

    /* Form side — 60% of full viewport */
    .form-side {
      flex: 0 0 60%;
      width: 60%;
      background: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(40px, 6vw, 100px);
    }

    /* Purple side — 40% of full viewport */
    .purple-side {
      flex: 0 0 40%;
      width: 40%;
      background-color: #712f79;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 48px;
    }

    /* Inputs */
    .pos-input {
      width: 100%;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 14px 14px 14px 44px;
      font-size: clamp(13px, 1.1vw, 15px);
      font-family: 'Inter', sans-serif;
      color: #111827;
      background: #f9fafb;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .pos-input:focus {
      border-color: #712f79;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(113,47,121,0.08);
    }
    .pos-input::placeholder { color: #9ca3af; }

    .input-wrap { position: relative; }
    .input-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 17px;
      height: 17px;
      color: #9ca3af;
      pointer-events: none;
    }
    .toggle-pw {
      position: absolute;
      right: 14px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 12px;
      color: #9ca3af;
      cursor: pointer;
      user-select: none;
      transition: color 0.15s;
    }
    .toggle-pw:hover { color: #712f79; }

    .btn-submit {
      width: 100%;
      padding: 15px;
      border-radius: 10px;
      background-color: #712f79;
      color: #fff;
      font-size: clamp(13px, 1.1vw, 15px);
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      letter-spacing: 0.3px;
      border: none;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.1s;
    }
    .btn-submit:hover { opacity: 0.9; }
    .btn-submit:active { transform: scale(0.98); }

    .deco-circle {
      position: absolute;
      border-radius: 50%;
      background: rgba(255,255,255,0.07);
    }

    /* Mobile: stack vertically */
    @media (max-width: 640px) {
      .page { flex-direction: column; height: auto; min-height: 100vh; }
      .form-side { flex: none; width: 100%; padding: 48px 28px; }
      .purple-side { flex: none; width: 100%; min-height: 280px; padding: 40px 28px; }
    }
  </style>
</head>
<body>

<div class="page">

  <!-- LEFT: Form (60% of screen) -->
  <div class="form-side">

    <!-- Brand -->
    <div style="margin-bottom: clamp(28px, 4vh, 48px);">
      <h1 style="font-size: clamp(22px, 2.5vw, 32px); font-weight: 700; color: #111827; letter-spacing: -0.5px;">POS</h1>
      <p style="font-size: clamp(12px, 1vw, 14px); color: #9ca3af; margin-top: 5px;">Point of Sale Management System</p>
    </div>

    <h2 style="font-size: clamp(18px, 2vw, 24px); font-weight: 600; color: #1f2937; margin-bottom: clamp(20px, 3vh, 32px);">Login</h2>

    <%= form_with url: user_login_index_path, method: :post do |f| %>

      <!-- Email -->
      <div class="input-wrap" style="margin-bottom: clamp(12px, 2vh, 20px);">
        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        <%= f.text_field :email,
              placeholder: "Email Address",
              autocomplete: "username",
              class: "pos-input" %>
      </div>

      <!-- Password -->
      <div class="input-wrap" style="margin-bottom: clamp(12px, 2vh, 20px);">
        <svg class="input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <%= f.password_field :password,
              placeholder: "Password",
              autocomplete: "current-password",
              id: "password",
              class: "pos-input" %>
        <span class="toggle-pw" onclick="togglePassword()" id="toggleBtn">Show</span>
      </div>

      <!-- Remember me -->
      <div style="display:flex; align-items:center; gap:9px; margin-bottom: clamp(20px, 3vh, 32px);">
        <%= f.check_box :remember_me, {
          id: "remember_me",
          style: "accent-color: #712f79; width:15px; height:15px; cursor:pointer; flex-shrink:0;"
        } %>
        <label for="remember_me" style="font-size: clamp(12px, 1vw, 14px); color:#6b7280; cursor:pointer; user-select:none;">
          Keep me logged in
        </label>
      </div>

      <!-- Submit -->
      <%= f.submit "Log in", class: "btn-submit" %>

    <% end %>

  </div>

  <!-- RIGHT: Purple panel (40% of screen) -->
  <div class="purple-side">

    <!-- Decorative circles -->
    <div class="deco-circle" style="width:35vw; height:35vw; max-width:400px; max-height:400px; top:-10%; right:-10%;"></div>
    <div class="deco-circle" style="width:25vw; height:25vw; max-width:300px; max-height:300px; bottom:-8%; left:-8%;"></div>
    <div class="deco-circle" style="width:12vw; height:12vw; max-width:140px; max-height:140px; bottom:20%; right:-4%; opacity:0.5;"></div>

    <!-- Logo -->
    <div style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap: clamp(16px, 3vh, 28px);">

      <%= image_tag "Example_Logo.png",
      style: "width: clamp(120px, 18vw, 180px); height: auto; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.15));",
      alt: "Logo" %>

      <div style="text-align:center;">
        <p style="color:#fff; font-weight:700; font-size:clamp(15px, 1.6vw, 20px); letter-spacing:0.2px;">Welcome back</p>
        <p style="color:rgba(255,255,255,0.65); font-size:clamp(12px, 1vw, 14px); margin-top:8px; line-height:1.7;">Sign in to get started.</p>
      </div>

    </div>
  </div>

</div>

<script>
  function togglePassword() {
    const input = document.getElementById('password');
    const btn = document.getElementById('toggleBtn');
    if (input.type === 'password') {
      input.type = 'text';
      btn.textContent = 'Hide';
    } else {
      input.type = 'password';
      btn.textContent = 'Show';
    }
  }
</script>

</body>
</html>
