<div class="flux-header">
  <h1>Take Payment</h1>
</div>

<div class="max-w-md mx-auto">
  <div class="flux-card mb-6">
    <div class="flex justify-between text-lg font-bold">
      <span>Amount Due:</span>
      <span>£<%= '%.2f' % @sale.amount_due %></span>
    </div>
  </div>

  <%= form_with model: @payment, url: till_ui_sale_payments_path(@sale), class: "flux-card" do |form| %>
    <% if @payment.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <ul class="list-disc list-inside text-red-600">
          <% @payment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-6">
      <%= form.label :amount, class: "block text-sm font-medium mb-2" %>
      <%= form.number_field :amount,
          step: 0.01,
          min: 0.01,
          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" %>
    </div>

    <div class="mb-6">
      <%= form.label :method, "Payment Method", class: "block text-sm font-medium mb-3" %>
      <div class="grid grid-cols-2 gap-4">
        <label class="cursor-pointer">
          <%= form.radio_button :method, "cash", class: "peer sr-only", required: true %>
          <div class="p-6 border-2 border-gray-300 rounded-lg text-center peer-checked:border-purple-500 peer-checked:bg-purple-50 hover:bg-gray-50 transition">
            <div class="text-3xl mb-2">💵</div>
            <div class="font-semibold">Cash</div>
          </div>
        </label>
        <label class="cursor-pointer">
          <%= form.radio_button :method, "card", class: "peer sr-only", required: true %>
          <div class="p-6 border-2 border-gray-300 rounded-lg text-center peer-checked:border-purple-500 peer-checked:bg-purple-50 hover:bg-gray-50 transition">
            <div class="text-3xl mb-2">💳</div>
            <div class="font-semibold">Card</div>
          </div>
        </label>
      </div>
    </div>

    <div class="flex gap-4">
      <%= link_to "Cancel", till_ui_sale_path(@sale), class: "flux-btn flux-btn-secondary flex-1 text-center" %>
      <%= form.submit "Confirm Payment", class: "flux-btn flex-1 cursor-pointer" %>
    </div>
  <% end %>
</div>
