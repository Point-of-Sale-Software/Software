<div class="max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6">Take Payment</h1>

  <div class="bg-gray-50 rounded-lg p-4 mb-6">
    <div class="flex justify-between text-lg font-bold">
      <span>Amount Due:</span>
      <span>£<%= '%.2f' % @sale.amount_due %></span>
    </div>
  </div>

  <%= form_with model: @payment, url: till_ui_sale_payments_path(@sale), class: "space-y-6" do |form| %>
    <% if @payment.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <ul class="list-disc list-inside text-red-600">
          <% @payment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :amount, class: "block text-sm font-medium mb-1" %>
      <%= form.number_field :amount,
          step: 0.01,
          min: 0.01,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= form.label :method, "Payment Method", class: "block text-sm font-medium mb-3" %>
      <div class="grid grid-cols-2 gap-4">
        <label class="cursor-pointer">
          <%= form.radio_button :method, "cash", class: "peer sr-only", required: true %>
          <div class="p-6 border-2 border-gray-300 rounded-lg text-center peer-checked:border-green-500 peer-checked:bg-green-50 hover:bg-gray-50 transition">
            <div class="text-3xl mb-2">💵</div>
            <div class="font-semibold">Cash</div>
          </div>
        </label>
        <label class="cursor-pointer">
          <%= form.radio_button :method, "card", class: "peer sr-only", required: true %>
          <div class="p-6 border-2 border-gray-300 rounded-lg text-center peer-checked:border-green-500 peer-checked:bg-green-50 hover:bg-gray-50 transition">
            <div class="text-3xl mb-2">💳</div>
            <div class="font-semibold">Card</div>
          </div>
        </label>
      </div>
    </div>

    <div class="flex gap-4">
      <%= link_to "Cancel",
          till_ui_sale_path(@sale),
          class: "flex-1 text-center py-3 bg-gray-200 hover:bg-gray-300 rounded-lg font-medium transition" %>
      <%= form.submit "Confirm Payment",
          class: "flex-1 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg cursor-pointer transition" %>
    </div>
  <% end %>
</div>
