<div class="flux-header">
  <h1>Select a Till</h1>
</div>

<% if @sessions.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @sessions.each do |session| %>
      <%= link_to till_ui_start_path(session), class: "flux-card hover:shadow-lg transition cursor-pointer border-2 border-transparent hover:border-purple-500" do %>
        <div class="text-center">
          <div class="text-3xl mb-3">🖥️</div>
          <h3 class="text-xl font-semibold"><%= session.till.name || "Till #{session.till_id}" %></h3>
          <p class="text-gray-500 mt-1">Opened <%= time_ago_in_words(session.opened_at) %> ago</p>
          <p class="text-sm text-gray-400 mt-2">Float: £<%= '%.2f' % session.opening_float %></p>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="flux-card">
    <div class="flux-empty">
      <div class="flux-empty-icon">📭</div>
      <h2 class="text-xl font-semibold mb-2">No Active Till Sessions</h2>
      <p class="text-gray-500">Ask an administrator to open a till session before you can start a sale.</p>
    </div>
  </div>
<% end %>
