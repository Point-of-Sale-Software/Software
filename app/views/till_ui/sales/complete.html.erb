<div class="flux-header">
  <h1>Sale Complete</h1>
</div>

<div class="max-w-md mx-auto">
  <div class="flux-card text-center mb-6">
    <div class="text-6xl mb-4 text-green-500">✓</div>
    <h2 class="text-2xl font-bold text-green-700 mb-2">Thank You!</h2>
    <p class="text-gray-600">Transaction completed successfully</p>
  </div>

  <div class="flux-card mb-6">
    <h3 class="font-bold mb-4">Sale Summary</h3>

    <div class="space-y-2 text-sm mb-4">
      <% @sale.sale_items.includes(:item).each do |sale_item| %>
        <div class="flex justify-between">
          <span><%= sale_item.quantity %> × <%= sale_item.item.name %></span>
          <span>£<%= '%.2f' % (sale_item.gross_price * sale_item.quantity) %></span>
        </div>
      <% end %>
    </div>

    <div class="border-t pt-3 space-y-2">
      <div class="flex justify-between font-bold text-lg">
        <span>Total:</span>
        <span>£<%= '%.2f' % @sale.total_gross %></span>
      </div>
    </div>

    <div class="border-t pt-3 mt-3 space-y-2 text-sm">
      <h4 class="font-semibold">Payments:</h4>
      <% @sale.payments.each do |payment| %>
        <div class="flex justify-between">
          <span class="capitalize"><%= payment.method %></span>
          <span>£<%= '%.2f' % payment.amount %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%= link_to "Start New Sale", till_ui_root_path, class: "flux-btn block text-center" %>
</div>
