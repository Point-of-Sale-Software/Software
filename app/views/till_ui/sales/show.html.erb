<div class="flux-header">
  <h1>Create Transaction</h1>
</div>

<div class="flux-content">
  <!-- Products Grid -->
  <div class="flux-products">
    <% @items.each do |item| %>
      <%= button_to till_ui_sale_sale_items_path(@sale, item_id: item.id),
          method: :post,
          class: "flux-product-card" do %>
        <h3><%= item.name %></h3>
        <p class="price">£<%= '%.2f' % item.gross_price %></p>
      <% end %>
    <% end %>

    <% if @items.empty? %>
      <div class="flux-empty col-span-full">
        <div class="flux-empty-icon">📦</div>
        <p>No items available</p>
      </div>
    <% end %>
  </div>

  <!-- Cart Panel -->
  <div class="flux-cart">
    <h2>Transaction</h2>

    <div class="flux-cart-items">
      <% if @sale_items.any? %>
        <% @sale_items.each do |sale_item| %>
          <div class="flux-cart-item">
            <div>
              <div class="flux-cart-item-name"><%= sale_item.item.name %></div>
              <div class="flux-cart-item-qty">Qty: <%= sale_item.quantity %></div>
            </div>
            <div class="flex items-center gap-2">
              <span class="flux-cart-item-price">£<%= '%.2f' % (sale_item.gross_price * sale_item.quantity) %></span>
              <%= button_to till_ui_sale_sale_item_path(@sale, sale_item),
                  method: :delete,
                  class: "flux-cart-item-remove" do %>
                ✕
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flux-empty">
          <div class="flux-empty-icon">🛒</div>
          <p>No items in basket</p>
        </div>
      <% end %>
    </div>

    <div class="flux-cart-totals">
      <div class="flux-cart-total-row">
        <span>Subtotal</span>
        <span>£<%= '%.2f' % @sale.total_net %></span>
      </div>
      <div class="flux-cart-total-row">
        <span>VAT</span>
        <span>£<%= '%.2f' % @sale.total_vat %></span>
      </div>
      <div class="flux-cart-total-row grand-total">
        <span>Total</span>
        <span>£<%= '%.2f' % @sale.total_gross %></span>
      </div>

      <% if @sale.total_paid > 0 %>
        <div class="flux-cart-total-row text-green-600">
          <span>Paid</span>
          <span>£<%= '%.2f' % @sale.total_paid %></span>
        </div>
        <div class="flux-cart-total-row font-bold">
          <span>Due</span>
          <span>£<%= '%.2f' % @sale.amount_due %></span>
        </div>
      <% end %>
    </div>

    <% if @sale_items.any? %>
      <%= link_to "Checkout", new_till_ui_sale_payment_path(@sale), class: "flux-btn" %>
    <% else %>
      <button class="flux-btn" disabled>Checkout</button>
    <% end %>
  </div>
</div>
