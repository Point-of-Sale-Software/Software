<% content_for :title, "Admin Dashboard" %>

<div class="w-full">
  <h1 class="text-3xl font-bold mb-6">Welcome, <%= @user.name || @user.email_address %>!</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Today's Sales -->
    <div class="bg-white rounded-lg border p-6">
      <h2 class="text-xl font-semibold mb-4">Today's Sales</h2>

      <% if @todays_sales.any? %>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-600">Transactions:</span>
            <span class="font-semibold"><%= @todays_sales.count %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Net:</span>
            <span class="font-semibold">£<%= '%.2f' % @todays_sales.sum(&:total_net) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">VAT:</span>
            <span class="font-semibold">£<%= '%.2f' % @todays_sales.sum(&:total_vat) %></span>
          </div>
          <div class="flex justify-between border-t pt-3">
            <span class="text-gray-600">Gross:</span>
            <span class="font-bold text-lg">£<%= '%.2f' % @todays_sales.sum(&:total_gross) %></span>
          </div>

          <% if @todays_payments.any? %>
            <div class="border-t pt-3 mt-3">
              <div class="text-sm text-gray-500 mb-2">By Payment Method:</div>
              <% @todays_payments.each do |method, amount| %>
                <div class="flex justify-between">
                  <span class="text-gray-600 capitalize"><%= method %>:</span>
                  <span class="font-semibold">£<%= '%.2f' % amount %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">No sales completed today.</p>
      <% end %>

      <div class="mt-4 pt-4 border-t">
        <%= link_to "View All Sales", admin_sales_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
      </div>
    </div>

    <!-- Active Till Sessions -->
    <div class="bg-white rounded-lg border p-6">
      <h2 class="text-xl font-semibold mb-4">Active Till Sessions</h2>

      <% if @active_sessions.any? %>
        <div class="space-y-3">
          <% @active_sessions.each do |session| %>
            <%= link_to admin_till_till_session_path(session.till, session), class: "flex justify-between items-center p-3 bg-gray-50 hover:bg-gray-100 rounded-lg transition" do %>
              <div>
                <div class="font-semibold"><%= session.till.name || "Till #{session.till_id}" %></div>
                <div class="text-sm text-gray-500">Opened <%= time_ago_in_words(session.opened_at) %> ago</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-gray-500">Float</div>
                <div class="font-semibold">£<%= '%.2f' % session.opening_float %></div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-gray-500">No active till sessions.</p>
      <% end %>

      <div class="mt-4 pt-4 border-t">
        <%= link_to "Manage Tills", admin_tills_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
      </div>
    </div>
  </div>
</div>
