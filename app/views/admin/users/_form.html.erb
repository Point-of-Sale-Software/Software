<%= form_with model: [:admin, user], class: "space-y-6" do |form| %>
  <% if user.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="font-semibold text-red-700 mb-2"><%= pluralize(user.errors.count, "error") %> prevented this user from being saved:</h3>
      <ul class="list-disc list-inside text-red-600">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium mb-1" %>
    <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :email_address, class: "block text-sm font-medium mb-1" %>
    <%= form.email_field :email_address, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :password, user.persisted? ? "Password (leave blank to keep current)" : "Password", class: "block text-sm font-medium mb-1" %>
    <%= form.password_field :password, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div>
    <%= form.label :password_confirmation, class: "block text-sm font-medium mb-1" %>
    <%= form.password_field :password_confirmation, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :admin, class: "w-4 h-4 rounded border-gray-300 text-purple-600 focus:ring-purple-500" %>
    <%= form.label :admin, "Administrator", class: "text-sm font-medium" %>
  </div>

  <div class="flex gap-4">
    <%= form.submit class: "rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= link_to "Cancel", admin_users_path, class: "rounded-md px-4 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
  </div>
<% end %>
